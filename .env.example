# Environment Variables
NODE_ENV=production

# SMTP für das Kontaktformular (Port 465 = SSL, 587 = STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Absender und Empfänger der Anfragen
MAIL_FROM=Westagentur <mail@westagentur.de>
MAIL_TO=mail@westagentur.de

# Optional
# RATE_LIMIT_MAX=5            # Anfragen pro IP ...
# RATE_LIMIT_WINDOW_MIN=60    # ... je Zeitfenster in Minuten
# BACKUP_KEEP_DAYS=14

# Öffentliche Adresse (für Links in E-Mails)
PUBLIC_URL=https://westagentur.de

# Admin-Bereich /admin (leer = deaktiviert). Langes, zufälliges Passwort verwenden!
ADMIN_PASSWORD=
# Nur für lokales Testen ohne HTTPS auf false setzen
# SECURE_COOKIES=true

# Vapi-Webhook /api/vapi (gleicher Wert wie "Server Secret" im Vapi-Dashboard; leer = deaktiviert)
VAPI_WEBHOOK_SECRET=

# Link zur Google-Bewertung (für automatische Bewertungsanfrage, optional)
GOOGLE_REVIEW_URL=

# Uhrzeit der täglichen Übersicht per E-Mail (Europe/Berlin)
# DIGEST_HOUR=7
