# Environment Variables
NODE_ENV=production

# SMTP für das Kontaktformular (Port 465 = SSL, 587 = STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Absender und Empfänger der Anfragen
MAIL_FROM=Westagentur <mail@westagentur.de>
MAIL_TO=mail@westagentur.de

# Optional
# RATE_LIMIT_MAX=5            # Anfragen pro IP ...
# RATE_LIMIT_WINDOW_MIN=60    # ... je Zeitfenster in Minuten
# BACKUP_KEEP_DAYS=14
